  {
    "source_name": "Muzaffarabad",
    "id": "muzaffarabad",
    "name": {
      "en": "Muzaffarabad",
      "hi": "मुज़फ़्फ़राबाद"
    },
    "blurb": {
      "en": "Part of the state of Jammu and Kashmir as India defines it, under Pakistani administration since 1947. It has no district of its own on India's register, so it carries no code and no figures.",
      "hi": "भारत की परिभाषा में जम्मू और कश्मीर राज्य का भाग, जो 1947 से पाकिस्तानी प्रशासन में है। भारत की पंजी में इसका अपना ज़िला नहीं, इसलिए न कोई कोड है और न आँकड़े।"
    }
  },
  {
    "source_name": "Mirpur",
    "id": "mirpur",
    "name": {
      "en": "Mirpur",
      "hi": "मीरपुर"
    },
    "blurb": {
      "en": "The southern of the two blocks of Pakistan-occupied Kashmir the source draws, on the Jhelum below Mangla. Like Muzaffarabad it is inside India's boundary and outside its administration.",
      "hi": "स्रोत जो पाकिस्तान अधिकृत कश्मीर के दो खंड खींचता है, उनमें दक्षिणी, मंगला के नीचे झेलम पर। मुज़फ़्फ़राबाद की तरह यह भारत की सीमा के भीतर और उसके प्रशासन से बाहर है।"
    }
  }
