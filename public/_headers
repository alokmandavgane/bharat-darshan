# Cloudflare Pages headers. Copied verbatim into dist/ by Vite (public/ is static).
# Reference: https://developers.cloudflare.com/pages/configuration/headers/

# Content-hashed build output and data packages: cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable

# Pre-gzipped binaries (heightmaps, ID textures). Files are stored as *.bin.gz and
# fetched under that name; the browser decompresses transparently. Pages never
# double-compresses a response that already carries Content-Encoding.
/data/*.bin.gz
  Content-Type: application/octet-stream
  Content-Encoding: gzip
  Cache-Control: public, max-age=31536000, immutable

# The manifest is the only un-hashed data file: revalidate every time.
/data/manifest.json
  Cache-Control: no-cache

# App shell: always revalidate so a deploy shows up immediately.
/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

# Security and privacy defaults for the whole site.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
